# MongoDB Atlas Local (default local connection) or Atlas cloud SRV
MONGODB_URI="mongodb://localhost/?directConnection=true"
# Database name in MongoDB
MONGODB_DB="aicon"

# Better Auth secret key (generate with openssl rand -base64 32)
BETTER_AUTH_SECRET="aicon-hackathon-development-secret-key-32-chars-minimum"
# Canonical base URL for Better Auth callbacks
BETTER_AUTH_URL="http://localhost:3000"

# Vercel AI Gateway API key (BYOK supported)
AI_GATEWAY_API_KEY=""
# Primary Google Gemini API key
GOOGLE_GENERATIVE_AI_API_KEY=""
# Secondary Google Gemini API key (fallback when primary hits quota)
GOOGLE_GENERATIVE_AI_API_KEY_B=""
# OpenRouter API key (tertiary fallback for free model endpoints)
OPENROUTER_API_KEY=""

# Vercel Blob read/write token for file uploads (filesystem is ephemeral)
BLOB_READ_WRITE_TOKEN=""

# Upstash Redis REST URL for rate limiting
UPSTASH_REDIS_REST_URL=""
# Upstash Redis REST Token for rate limiting
UPSTASH_REDIS_REST_TOKEN=""

# Sentry DSN for error monitoring
SENTRY_DSN=""

# Demo user email for seeding and local tests
DEMO_USER_EMAIL="demo@example.com"

# Apify API Token for automated LinkedIn profile search & candidate scouting
APIFY_API_TOKEN=""

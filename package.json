{
  "name": "aicon-hackathon",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "apps/web",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspace=apps/web",
    "typecheck": "npm run typecheck --workspace=apps/web",
    "lint": "npm run lint --workspace=apps/web",
    "format": "npm run format --workspace=apps/web",
    "test": "npm run test --workspace=apps/web",
    "test:e2e": "npm run test:e2e --workspace=apps/web",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:indexes": "npm run db:indexes --workspace=apps/web",
    "db:seed": "npm run db:seed --workspace=apps/web",
    "db:reset": "npm run db:reset --workspace=apps/web",
    "db:reembed": "npm run db:reembed --workspace=apps/web",
    "evals": "npm run evals --workspace=apps/web"
  }
}
